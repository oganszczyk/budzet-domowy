{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // Node jest tu wymieniony celowo: adapter bazy do testów importuje
    // node:sqlite, a testy migracji node:fs, node:os i node:path.
    // Bez tego wpisu typy Node trafiały tu przypadkiem, przez zależności
    // Jesta — działało lokalnie i padało na czystej instalacji.
    "types": ["jest", "node"],
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
